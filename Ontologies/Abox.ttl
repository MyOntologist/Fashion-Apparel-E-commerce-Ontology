@prefix fashiono: <http://w3id.org/fashion#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .             
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .

# This ABOX import the TBox so all the rules apply here
<http://w3id.org/fashion> a owl:Ontology ;
    rdfs:label "Fashion Ontology"@en ;
    rdfs:comment "An ontology for representing fashion items, their attributes, and relationships."@en ;
    owl:imports <http://w3id.org/fashion/tbox> .

## Brands

fashiono:BrandZara 
    a fashiono:Brand ;
    fashiono:brandName "Zara" .

fashiono:BrandNike
    a fashiono:Brand ;
    fashiono:brandName "Nike" .

# Fixed: Removed '&' from the URI identifier
fashiono:BrandHM 
    a fashiono:Brand ;
    fashiono:brandName "HM" .

fashiono:BrandGucci 
    a fashiono:Brand ;
    fashiono:brandName "Gucci" .

fashiono:BrandLevis 
    a fashiono:Brand ;
    fashiono:brandName "Levi's" .

