## PRODUCTS -- Clothing

# Product 1 -- a linen dress from Zara
fashiono:Product_001
    a fashiono:FullBodyWear ;
    fashiono:productName "Coastal Linen Slip Dress" ;
    fashiono:productDescription "A lightweight linen dress with adjustable straps. Great for summer days at the beach or in the city." ;
    fashiono:sku "ZR-DRESS-001" ;
